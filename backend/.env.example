# Backend-only environment, for running the API directly (no Docker).
#
# Copy to `backend/.env`. Pydantic reads `.env` relative to the working
# directory, so running uvicorn from `backend/` picks this file up — the
# repo-root `.env` is what docker-compose passes to the container instead.

# ─── Database ─────────────────────────────────────────────────────────
# SQLite needs no server, which is enough to run the whole app locally.
# Switch to Postgres when you want to match the compose setup:
#   postgresql+asyncpg://jobpulse:jobpulse_pass@localhost:5432/jobpulse
DATABASE_URL=sqlite+aiosqlite:///./jobpulse.db

# ─── AI provider (optional) ───────────────────────────────────────────
# Leave blank and the app still works — matching falls back to the
# deterministic keyword scorer and every result is labelled `heuristic`.
#
# NOTE: these names have NO `VITE_` prefix, deliberately. A `VITE_`-prefixed
# variable is inlined into the public JavaScript bundle; these are read by the
# server only and never reach the browser.
LLM_PROVIDER=google
GOOGLE_API_KEY=
OPENAI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview
OPENAI_MODEL=gpt-4-turbo

# ─── Market scope ─────────────────────────────────────────────────────
# Keep only postings reachable from India. Set false to search worldwide.
INDIA_ONLY=true

# ─── Job sources ──────────────────────────────────────────────────────
# Remotive works with no credentials. Adzuna is skipped if these are blank.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Picks Adzuna's endpoint AND the currency its salaries come back in.
ADZUNA_COUNTRY=in

# ─── Naukri / LinkedIn / Indeed listings ──────────────────────────────
# None can be fetched directly (no public API, scraping prohibited), but all
# three syndicate into Google for Jobs, which these licensed aggregators
# index. Each posting keeps the name of the portal it came from. Every key is
# optional — a blank one disables that source only.
#
# JSearch: rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
#
# This file is for running uvicorn directly. docker compose reads the repo-root
# .env instead — this one is kept out of the image by .dockerignore — so a key
# set only here will not reach the container.
JSEARCH_API_KEY=
JSEARCH_API_HOST=jsearch.p.rapidapi.com
# The documented /search path now 404s; the live endpoint is /search-v2.
JSEARCH_ENDPOINT=/search-v2
JSEARCH_NUM_PAGES=1
JSEARCH_COUNTRY=in
JSEARCH_DATE_POSTED=month
# JSEARCH_PUBLISHERS=naukri,linkedin,indeed
#
# Careerjet: careerjet.com/partners/
CAREERJET_API_KEY=
CAREERJET_LOCALE=en_IN
#
# Jooble: jooble.org/api/about
JOOBLE_API_KEY=
JOOBLE_API_HOST=in.jooble.org

# ─── Loop scheduler ───────────────────────────────────────────────────
# Set false to run the API with no background fetching.
LOOP_SCHEDULER_ENABLED=true
LOOP_SCHEDULER_INTERVAL_SECONDS=300

# ─── Backend: company career boards (India-focused, no keys needed) ───
# Public ATS endpoints as `platform:company-slug` — the same URLs each
# company's own careers page calls. Supported platforms: greenhouse, lever,
# ashby. This is the primary India source, because Naukri/Indeed/LinkedIn/
# Foundit offer no usable public API and prohibit scraping.
#
# Leave unset to use the built-in list of Indian product companies. A slug
# that 404s is skipped with a warning rather than breaking the search.
# ATS_BOARDS=greenhouse:phonepe,greenhouse:groww,lever:meesho,ashby:atlan

# ─── CORS ─────────────────────────────────────────────────────────────
# The Vite dev server origin.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
