# JobPulse server configuration. Do not commit real credentials.
DATABASE_URL=postgresql+asyncpg://jobpulse:jobpulse_pass@localhost:5432/jobpulse
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Direct job sources. Indeed, Naukri, and LinkedIn must stay disabled until
# you have an approved provider integration; this project does not scrape them.
INDEED_ENABLED=false
INDEED_API_KEY=
NAUKRI_ENABLED=false
NAUKRI_API_KEY=
LINKEDIN_ENABLED=false
LINKEDIN_API_KEY=
REMOTIVE_ENABLED=true
ADZUNA_ENABLED=true
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
INDIA_ONLY=true

# Optional external MCP server. Use its actual Docker MCP Toolkit endpoint or command.
MCP_SERVER_NAME=linkedin
MCP_TRANSPORT=
MCP_ENDPOINT=
MCP_ENABLED=false

VITE_API_BASE_URL=http://localhost:8000/api

# JobSpy MCP (independent of the LinkedIn MCP agent). Docker service name is
# jobspy_mcp; use localhost when the API is run on the host against that port.
JOBSPY_ENABLED=true
JOBSPY_HOST=jobspy_mcp
JOBSPY_PORT=8500
JOBSPY_TIMEOUT_SECONDS=90
JOBSPY_SITE_TIMEOUT_SECONDS=60
