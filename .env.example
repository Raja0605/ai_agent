# JobPulse Environment Configuration
#
# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.
#
# ┌──────────────────────────────────────────────────────────────────────┐
# │ WARNING: any variable prefixed with VITE_ is INLINED INTO THE PUBLIC │
# │ JAVASCRIPT BUNDLE and readable by anyone who loads the page.         │
# │ Never put an API key behind a VITE_ prefix.                          │
# └──────────────────────────────────────────────────────────────────────┘

# ─── Backend: database ────────────────────────────────────────────────
# Inside docker compose this is overridden to point at the `postgres` service.
DATABASE_URL=postgresql+asyncpg://jobpulse:jobpulse_pass@postgres:5432/jobpulse

# ─── Backend: AI provider (server-side only, never exposed) ───────────
# Selects which provider handles /api/ai/*. With no key set, the API still
# works: matching falls back to a deterministic keyword scorer and every
# result is labelled `method: heuristic` so the UI can say so.
LLM_PROVIDER=google
GOOGLE_API_KEY=
OPENAI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview
OPENAI_MODEL=gpt-4-turbo

# ─── Backend: market scope ────────────────────────────────────────────
# Keep only postings reachable from India. This is what the app is for, and
# without it the remote-first and global sources bury local results under US
# and EU listings. Set to false to search worldwide.
INDIA_ONLY=true

# ─── Backend: job aggregation sources ─────────────────────────────────
# Remotive needs no credentials. Adzuna is skipped entirely if these are blank.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Adzuna is country-scoped: this picks both the endpoint and the currency its
# salary figures are denominated in. gb, us, in, de, au, ca, ...
ADZUNA_COUNTRY=in

# ─── Backend: Naukri / LinkedIn / Indeed listings ─────────────────────
# None of the three can be fetched directly:
#   * Naukri  — no public API, and scraping is prohibited by its terms.
#   * Indeed  — Publisher API and XML feed retired; what remains is an
#               NDA-gated enterprise data partnership.
#   * LinkedIn— job data is behind Talent Solutions partnership.
#
# All three syndicate into Google for Jobs, which licensed aggregators index
# and resell. The keys below are the supported route to that inventory. Each
# posting keeps the name of the portal it came from, so results still show as
# Naukri, LinkedIn or Indeed rather than as one opaque aggregator.
#
# Every one of these is optional. A blank key disables that source only — the
# search still runs on whatever else is configured, including the company
# career boards below, which need no credentials at all.

# JSearch — the widest Google for Jobs coverage. Sign up at
# rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch (free tier available).
#
# NOTE for docker compose: it loads THIS file (repo root). A key placed in
# backend/.env is used when running uvicorn directly, but is excluded from the
# image by backend/.dockerignore and will NOT reach the container.
JSEARCH_API_KEY=
JSEARCH_API_HOST=jsearch.p.rapidapi.com
# The path has already moved once — the documented /search now 404s. Override
# here if it moves again rather than patching the adapter.
JSEARCH_ENDPOINT=/search-v2
# Results per call, in pages of ~10. Each page costs quota.
JSEARCH_NUM_PAGES=1
JSEARCH_COUNTRY=in
# How far back to look: all | today | 3days | week | month
JSEARCH_DATE_POSTED=month
# Optional allowlist of portals. Blank keeps every publisher returned.
# JSEARCH_PUBLISHERS=naukri,linkedin,indeed

# Careerjet — free affiliate key, India locale. Register at
# careerjet.com/partners/
CAREERJET_API_KEY=
CAREERJET_LOCALE=en_IN

# Jooble — free key on request at jooble.org/api/about
JOOBLE_API_KEY=
JOOBLE_API_HOST=in.jooble.org

# ─── Backend: loop scheduler ──────────────────────────────────────────
# Background runner for saved search campaigns. Set to false to run the API
# without any background fetching.
LOOP_SCHEDULER_ENABLED=true
# How often the scheduler checks for loops whose cadence has elapsed.
LOOP_SCHEDULER_INTERVAL_SECONDS=300

# ─── Backend: company career boards (India-focused, no keys needed) ───
# Public ATS endpoints as `platform:company-slug` — the same URLs each
# company's own careers page calls. Supported platforms: greenhouse, lever,
# ashby. This is the primary India source, because Naukri/Indeed/LinkedIn/
# Foundit offer no usable public API and prohibit scraping.
#
# Leave unset to use the built-in list of Indian product companies. A slug
# that 404s is skipped with a warning rather than breaking the search.
# ATS_BOARDS=greenhouse:phonepe,greenhouse:groww,lever:meesho,ashby:atlan

# ─── Backend: CORS ────────────────────────────────────────────────────
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# ─── Frontend: public build-time values (safe to expose) ──────────────
# Where the browser reaches the API. Must be a URL the *browser* can resolve,
# not a docker-internal hostname.
#
# There are deliberately no VITE_*_MODEL variables. The UI reads the model
# actually in use from GET /api/ai/config, so the badge cannot drift away
# from what the server really calls.
VITE_API_BASE_URL=http://localhost:8000/api
